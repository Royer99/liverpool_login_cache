# ── MongoDB connection ────────────────────────────────────────────────────────
# Atlas SRV URI. Never commit the real one; .env is gitignored.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB=liverpool_login
MONGODB_COLLECTION=redis_dump
# Pool size per process. Must exceed per-Locust-worker concurrent users or the
# harness measures pool queuing and calls it database latency (asserted at start).
MONGODB_MAX_POOL_SIZE=500
MONGODB_READ_PREFERENCE=primary
MONGODB_WRITE_CONCERN=1

# ── Dataset shape (mirrors the QA RDB export) ─────────────────────────────────
# Source cluster had 3 shards; kept as a document field for per-shard reporting.
SHARD_COUNT=3
# Headline scale. Type mix below splits this into session vs index docs.
TOTAL_DOCUMENT_COUNT=16000000
# Observed key mix: ~86% session strings, ~14% per-user zset index docs.
STRING_SHARE=0.86
ZSET_SHARE=0.14
# Distinct principals owning index docs. Sanity-checked against ZSET_SHARE * TOTAL.
SYNTHETIC_USER_COUNT=800000
# Power-law exponent for sessions-per-user; a few principals hold thousands.
SESSIONS_PER_USER_SKEW=1.5
# Largest zset observed in the export (single principal with 16,571 sessions).
MAX_MEMBERS_PER_INDEX_DOC=16571
# Observed average members per index zset (~23-25 in the QA dump).
MEAN_MEMBERS_PER_INDEX_DOC=25
# Share of index members pointing at sessions that no longer exist as documents.
# The export drifts exactly like this; the two-step read path must cope.
INDEX_DOC_DRIFT_RATIO=0.4
# Observed average session string size (bytes of the keyv envelope).
PAYLOAD_TARGET_BYTES=3200
SESSION_TTL_DAYS=7
# Share of session docs generated with expiresAt in the past.
EXPIRED_SESSION_RATIO=0.1
RANDOM_SEED=42
# TTL index on expiresAt. Default OFF: the dataset carries past expiries and
# would delete itself mid-benchmark if enabled.
ENABLE_TTL_INDEX=false

# ── Load ──────────────────────────────────────────────────────────────────────
# Generator+loader processes. Each owns a contiguous ID range and derives its
# seed as RANDOM_SEED + worker_index, so determinism survives parallelism.
GENERATE_WORKERS=8
LOAD_BATCH_SIZE=1000
LOAD_CHECKPOINT_PATH=./.load_checkpoint.json

# ── Access distribution ───────────────────────────────────────────────────────
# Recency skew: HOT_ACCESS_SHARE of reads land in the most recent
# HOT_SET_RATIO of sessions. Report latency only next to this distribution.
HOT_SET_RATIO=0.05
HOT_ACCESS_SHARE=0.80

# ── Locust ────────────────────────────────────────────────────────────────────
LOCUST_USERS=500
LOCUST_SPAWN_RATE=50
LOCUST_RUN_TIME=2m
TARGET_READ_RPS=2000
# Share of total ops that are writes (update/insert/$push).
WRITE_RATIO=0
# Share of reads using the two-step index path (zset doc -> $in batch fetch).
INDEX_READ_RATIO=0.2
# Members fetched per index-doc read ($slice from the tail; the ZRANGE analog).
ZRANGE_LIMIT=50
READ_LATENCY_SLO_MS=10
